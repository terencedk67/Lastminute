{
  "expo": {
    "name": "LASTMINUTE",
    "slug": "lastminute",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "lastminute",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "ios": {
